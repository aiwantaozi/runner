+#[cfg(test)]
+mod group_removal_tests {
+    use super::*;
+    use crate::core::{
+        steps::worker::local::find_workers_by_url, BasicWorkerBuilder, DPAwareWorkerBuilder,
+    };
+
+    #[test]
+    fn rank_ids_resolve_to_their_entire_physical_group() {
+        let registry = Arc::new(WorkerRegistry::new());
+        let service = WorkerService::new(
+            registry.clone(),
+            Arc::new(std::sync::OnceLock::new()),
+            RouterConfig::default(),
+        );
+        let mut ids = Vec::new();
+        for rank in 0..2 {
+            ids.push(registry.register(Arc::new(
+                DPAwareWorkerBuilder::new("http://p:80", rank, 2).build(),
+            )));
+        }
+        registry.register(Arc::new(
+            DPAwareWorkerBuilder::new("http://other:80", 0, 1).build(),
+        ));
+        for id in ids {
+            let url = service.removal_url(&id).unwrap();
+            assert_eq!(url, "http://p:80");
+            let workers = find_workers_by_url(&registry, &url, true);
+            assert_eq!(workers.len(), 2);
+            assert!(workers
+                .iter()
+                .all(|worker| worker.endpoint_url("") == "http://p:80"));
+        }
+        let parent = registry.reserve_id_for_url("http://pending:80");
+        assert_eq!(service.removal_url(&parent).unwrap(), "http://pending:80");
+        let basic = registry.register(Arc::new(BasicWorkerBuilder::new("http://basic:80").build()));
+        let url = service.removal_url(&basic).unwrap();
+        assert_eq!(find_workers_by_url(&registry, &url, false).len(), 1);
+    }
+}
